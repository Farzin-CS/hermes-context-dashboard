+import { describe, expect, it } from "vitest";
+
+import { blockDirection, hasRtlText } from "./text-direction";
+
+describe("text direction", () => {
+  it("detects Persian and Arabic as RTL", () => {
+    expect(hasRtlText("سلام دنیا")).toBe(true);
+    expect(hasRtlText("مرحبا بالعالم")).toBe(true);
+  });
+
+  it("leaves English, code and paths LTR", () => {
+    expect(hasRtlText("hello world")).toBe(false);
+    expect(hasRtlText("C:\\Users\\ASUS\\state.db")).toBe(false);
+    expect(hasRtlText("```py\nprint('hi')\n```")).toBe(false);
+    expect(hasRtlText("")).toBe(false);
+    expect(hasRtlText(null)).toBe(false);
+  });
+
+  it("resolves a block from its first strong character", () => {
+    expect(blockDirection("سلام hello")).toBe("rtl");
+    expect(blockDirection("hello سلام")).toBe("ltr");
+    expect(blockDirection("12345")).toBeUndefined();
+  });
+});
