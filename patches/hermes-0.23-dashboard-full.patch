@@ -0,0 +1,37 @@
+import { describe, expect, it } from "vitest";
+
+import { buildFileMarkers, type ChatAttachment } from "./chat-attachments";
+
+function attachment(
+  overrides: Partial<ChatAttachment> & Pick<ChatAttachment, "kind" | "name" | "path">,
+): ChatAttachment {
+  return {
+    id: overrides.id ?? overrides.name,
+    size: overrides.size ?? 10,
+    ...overrides,
+  };
+}
+
+describe("buildFileMarkers", () => {
+  it("returns an empty string when nothing is attached", () => {
+    expect(buildFileMarkers([])).toBe("");
+  });
+
+  it("emits one TUI marker per file", () => {
+    const files = [
+      attachment({ kind: "file", name: "a.txt", path: "C:/uploads/a.txt" }),
+      attachment({ kind: "file", name: "b.pdf", path: "C:/uploads/b.pdf" }),
+    ];
+    expect(buildFileMarkers(files)).toBe(
+      "[User attached file: C:/uploads/a.txt]\n" +
+        "[User attached file: C:/uploads/b.pdf]",
+    );
+  });
+
+  it("does not emit markers for images", () => {
+    const images = [
+      attachment({ kind: "image", name: "one.png", path: "C:/images/one.png" }),
+    ];
+    expect(buildFileMarkers(images)).toBe("");
+  });
+});
diff --git a/web/src/lib/chat-attachments.ts b/web/src/lib/chat-attachments.ts
new file mode 100644
index 0000000000..62a5c84ab6
--- /dev/null
+++ b/web/src/lib/chat-attachments.ts
@@ -0,0 +1,25 @@
+/** Pure helpers for the chat attachment bar. */
+
+export type ChatAttachmentKind = "image" | "file";
+
+export interface ChatAttachment {
+  id: string;
+  name: string;
+  path: string;
+  kind: ChatAttachmentKind;
+  size: number;
+}
+
+/**
+ * Build the text injected into the TUI composer when the user presses Enter.
+ *
+ * Images are attached with the TUI's ``/image`` command as soon as they finish
+ * uploading, so they never enter this text. Files use the same
+ * ``[User attached file: …]`` marker the TUI emits for a dropped file.
+ */
+export function buildFileMarkers(attachments: ChatAttachment[]): string {
+  return attachments
+    .filter((attachment) => attachment.kind === "file" && attachment.path)
+    .map((attachment) => `[User attached file: ${attachment.path}]`)
+    .join("\n");
+}
diff --git a/web/src/lib/chat-file-upload.ts b/web/src/lib/chat-file-upload.ts
new file mode 100644
index 0000000000..806814ff57
--- /dev/null
+++ b/web/src/lib/chat-file-upload.ts
@@ -0,0 +1,55 @@
+/**
+ * Upload a browser-picked chat file to the gateway.
+ *
+ * The dashboard Chat tab is an xterm mirror of a TUI running inside the
+ * gateway, so the browser must stage the bytes first. The returned path is
+ * under the active profile's ``uploads/`` directory and is visible to the
+ * agent's file tools.
+ */
+import { authedFetch } from "@/lib/api";
+
+export interface StagedChatFileUpload {
+  install_id: string;
+  path: string;
+  profile_home: string;
+}
+
+export interface ChatFileUploadResult {
+  ok: boolean;
+  path: string;
+  size: number;
+  staged_upload?: StagedChatFileUpload;
+}
+
+export async function uploadChatFile(
+  file: File,
+  profile = "",
+): Promise<ChatFileUploadResult> {
+  if (!file.size) throw new Error("file is empty");
+
+  const form = new FormData();
+  form.append("file", file, file.name || "attachment");
+  const qs = profile ? `?profile=${encodeURIComponent(profile)}` : "";
+  const res = await authedFetch(`/api/chat/dashboard-file-upload${qs}`, {
+    method: "POST",
+    body: form,
+  });
+
+  if (!res.ok) {
+    const text = await res.text().catch(() => res.statusText);
+    let detail = text;
+    try {
+      const parsed = JSON.parse(text) as { detail?: unknown };
+      if (typeof parsed.detail === "string" && parsed.detail) detail = parsed.detail;
+    } catch {
+      /* plain-text error body */
+    }
+    throw new Error(detail || `HTTP ${res.status}`);
+  }
+
+  const uploaded = (await res.json()) as ChatFileUploadResult;
+  if (!uploaded?.path) {
+    throw new Error("file upload did not return a path");
+  }
+  return uploaded;
+}
