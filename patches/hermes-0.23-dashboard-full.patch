+import { defineLocale } from "./define-locale";
+
+/**
+ * Persian (fa) dashboard locale.
+ *
+ * Partial on purpose: every untranslated key falls back to English via
+ * `defineLocale`. The shell, navigation, session/analytics pages and the
+ * Context Lens tab are translated; deeper settings pages fill in over time.
+ */
+export const fa = defineLocale({
+  common: {
+    save: "ذخیره",
+    saving: "در حال ذخیره…",
+    cancel: "انصراف",
+    close: "بستن",
+    confirm: "تأیید",
+    delete: "حذف",
+    refresh: "تازه‌سازی",
+    retry: "تلاش دوباره",
+    loadFailed: "بارگذاری {what} ممکن نشد. مطمئن شوید سرور داشبورد در حال اجراست و روی تلاش دوباره بزنید.",
