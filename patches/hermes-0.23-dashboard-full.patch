+async def upload_dashboard_chat_file(
+    file: UploadFile = File(...),
+    profile: Optional[str] = None,
+):
+    """Stage a file picked in the dashboard chat composer.
+
+    The Webapp-only ``/api/chat/file-upload`` route is intentionally absent on
+    the standalone dashboard surface. The embedded TUI chat still needs a
+    browser-picked file to reach the agent, so this dashboard-scoped route
+    publishes the bytes under the active profile's ``uploads/`` directory and
+    returns the path the composer types as ``[User attached file: …]``.
+    """
