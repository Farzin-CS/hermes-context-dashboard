+def _sweep_empty_sessions(profile: Optional[str]) -> int:
+    """Run the empty-session sweep against the profile's store.
+
+    Offline (no runtime owner) the exclusive maintenance reservation does the
+    work. While a gateway owns the profile — the normal case for a dashboard
+    opened next to a running Hermes — that reservation is refused by design
+    ("Drain and stop the gateway, then retry"), which made this button a
+    guaranteed 409 and therefore a no-op. The sweep is one short transaction
+    and ``delete_empty_sessions`` skips sessions with live work, so it lands on
+    the same shared writable store a single-session delete uses instead.
+    """
+    sessions_dir = _session_files_dir(profile)
