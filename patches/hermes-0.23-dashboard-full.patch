diff --git a/web/src/index.css b/web/src/index.css
index e4b5e2777f..fcb5f3e1fc 100644
--- a/web/src/index.css
+++ b/web/src/index.css
@@ -253,3 +253,33 @@ html[dir="rtl"] {
   direction: rtl;
 }
 
+/* Per-block text direction for agent output.
+   `unicode-bidi: plaintext` resolves each line from its own first strong
+   character, so a mixed reply (English heading, Persian paragraph, shell
+   command) lays out correctly without flipping the rest of the dashboard.
+   Code stays LTR even inside an RTL block. `text-align: start` follows the
+   resolved direction (right for RTL, left for LTR). */
+.hermes-md-block {
+  unicode-bidi: plaintext;
+  text-align: start;
+}
+
+.hermes-md-block li {
+  text-align: start;
+}
+
+.hermes-md-code,
+.hermes-md-code code,
+.hermes-md code[dir="ltr"] {
+  unicode-bidi: isolate;
+  direction: ltr;
+}
+
+/* Session transcript bubbles: keep long unbroken tokens (paths, hashes,
+   URLs) from forcing a horizontal scrollbar inside a bubble. */
+.hermes-message-bubble {
+  overflow-wrap: anywhere;
+  word-break: normal;
+}
+
+
