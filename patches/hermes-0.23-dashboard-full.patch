+async def _empty_session_sweep_loop(
+    interval_s: float = 900.0, initial_delay_s: float = 120.0) -> None:
+    """Silently discard never-used conversations.
+
+    A dashboard chat creates a session row as soon as its PTY starts, before a
+    single message exists. The desktop app models those as drafts and never
+    stores them; the dashboard cannot defer the store, so it reaps them on a
+    short timer instead. ``delete_empty_sessions`` is the same transaction the
+    "Delete empty" button used: it skips active (``ended_at IS NULL``) and
+    archived rows, so a live handshake, a user-kept archive, and a rewound
+    transcript whose soft-archived rows are the only copy are all safe.
+
+    Runs at 15 minutes, first pass two minutes after boot, and degrades a
+    missing/owned store to a debug line — maintenance must never take the
+    dashboard down.
+    """
+    await asyncio.sleep(initial_delay_s)
+    while True:
+        try:
+            await asyncio.to_thread(_sweep_empty_sessions_once, None)
+        except Exception as exc:
+            _log.debug("empty-session sweep skipped: %s", exc)
+        await asyncio.sleep(interval_s)
+
+
+def _sweep_empty_sessions_once(profile: Optional[str]) -> None:
+    """One empty-session pass through the router's gateway-aware helper."""
+    from hermes_cli.web_routers.sessions import _sweep_empty_sessions
+
+    deleted = _sweep_empty_sessions(profile)
+    if deleted:
+        _log.info("empty-session sweep: removed %d draft session(s)", deleted)
