diff --git a/web/src/components/SessionActionsMenu.tsx b/web/src/components/SessionActionsMenu.tsx
new file mode 100644
index 0000000000..56c124efe9
--- /dev/null
+++ b/web/src/components/SessionActionsMenu.tsx
@@ -0,0 +1,147 @@
+import { useEffect, useLayoutEffect, useRef, useState } from "react";
+import { createPortal } from "react-dom";
+import type { LucideIcon } from "lucide-react";
+
+import { cn } from "@/lib/utils";
+
+export interface SessionMenuAction {
+  key: string;
+  label: string;
+  icon?: LucideIcon;
+  onSelect: () => void;
+  danger?: boolean;
+  disabled?: boolean;
+  /** Draw a divider above this item (grouping, e.g. destructive actions last). */
+  dividerBefore?: boolean;
+}
+
+/**
+ * A right-click / overflow menu for one session row.
+ *
+ * Portaled to `document.body` so the scrollable session rail can never clip
+ * it, then clamped to the viewport: a row near the bottom opens upward and a
+ * row near the right edge shifts left. Closes on outside pointerdown, Escape,
+ * scroll and resize, and restores focus to the trigger element.
+ */
+export function SessionActionsMenu({
+  x,
+  y,
+  actions,
+  onClose,
+  label,
+}: {
+  x: number;
+  y: number;
+  actions: SessionMenuAction[];
+  onClose: () => void;
+  label: string;
+}) {
+  const ref = useRef<HTMLDivElement>(null);
+  const [pos, setPos] = useState<{ left: number; top: number }>({ left: x, top: y });
+  const restoreFocusRef = useRef<Element | null>(null);
+
+  useLayoutEffect(() => {
+    const el = ref.current;
+    if (!el) return;
+    const rect = el.getBoundingClientRect();
+    const margin = 8;
+    const left = Math.min(
+      Math.max(margin, x),
+      Math.max(margin, window.innerWidth - rect.width - margin),
+    );
+    const top =
+      y + rect.height + margin > window.innerHeight
+        ? Math.max(margin, y - rect.height)
+        : Math.max(margin, y);
+    setPos({ left, top });
+  }, [x, y]);
+
+  useEffect(() => {
+    restoreFocusRef.current =
+      document.activeElement instanceof HTMLElement ? document.activeElement : null;
+    const first = ref.current?.querySelector<HTMLElement>("[role='menuitem']");
+    first?.focus({ preventScroll: true });
+
+    const onPointerDown = (event: PointerEvent) => {
+      if (!ref.current?.contains(event.target as Node)) onClose();
+    };
+    const onKeyDown = (event: KeyboardEvent) => {
+      if (event.key === "Escape") {
+        event.preventDefault();
+        onClose();
+        return;
+      }
+      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
+      const items = Array.from(
+        ref.current?.querySelectorAll<HTMLElement>("[role='menuitem']:not([disabled])") ?? [],
+      );
+      if (items.length === 0) return;
+      event.preventDefault();
+      const index = items.indexOf(document.activeElement as HTMLElement);
+      const step = event.key === "ArrowDown" ? 1 : -1;
+      const next = (index + step + items.length) % items.length;
+      items[next]?.focus({ preventScroll: true });
+    };
+    const close = () => onClose();
+
+    document.addEventListener("pointerdown", onPointerDown, true);
+    document.addEventListener("keydown", onKeyDown, true);
+    window.addEventListener("resize", close);
+    window.addEventListener("scroll", close, true);
+    return () => {
+      document.removeEventListener("pointerdown", onPointerDown, true);
+      document.removeEventListener("keydown", onKeyDown, true);
+      window.removeEventListener("resize", close);
+      window.removeEventListener("scroll", close, true);
+      if (restoreFocusRef.current instanceof HTMLElement) {
+        restoreFocusRef.current.focus({ preventScroll: true });
+      }
+    };
+  }, [onClose]);
+
+  return createPortal(
+    <div
+      ref={ref}
+      role="menu"
+      aria-label={label}
+      data-session-menu
+      className={cn(
+        "fixed z-[80] min-w-56 max-w-[calc(100vw-1rem)] py-1",
+        "border border-border bg-background-base text-foreground shadow-2xl",
+        "animate-[fade-in_120ms_ease-out]",
+      )}
+      style={{ left: pos.left, top: pos.top, direction: undefined }}
+    >
+      {actions.map((action) => {
+        const Icon = action.icon;
+        return (
+          <div key={action.key}>
+            {action.dividerBefore && <div className="my-1 border-t border-border" />}
+            <button
+              type="button"
+              role="menuitem"
+              disabled={action.disabled}
+              onClick={() => {
+                if (action.disabled) return;
+                onClose();
+                action.onSelect();
+              }}
+              className={cn(
+                "flex w-full items-center gap-2.5 px-3 py-1.5 text-start text-sm",
+                "normal-case tracking-normal",
+                action.danger
+                  ? "text-destructive hover:bg-destructive/10"
+                  : "text-foreground hover:bg-secondary/60",
+                action.disabled && "cursor-not-allowed opacity-40 hover:bg-transparent",
+              )}
+            >
+              {Icon ? <Icon className="h-3.5 w-3.5 shrink-0" aria-hidden /> : null}
+              <span className="min-w-0 flex-1 truncate">{action.label}</span>
+            </button>
+          </div>
+        );
+      })}
+    </div>,
+    document.body,
+  );
+}
diff --git a/web/src/components/SessionTranscript.tsx b/web/src/components/SessionTranscript.tsx
new file mode 100644
index 0000000000..e1977a6293
--- /dev/null
+++ b/web/src/components/SessionTranscript.tsx
@@ -0,0 +1,232 @@
+import { ArrowDown, MessageSquare, Terminal as TerminalIcon, Wrench } from "lucide-react";
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+
+import { Markdown } from "@/components/Markdown";
+import { useI18n } from "@/i18n";
+import { api, type SessionMessage } from "@/lib/api";
+import { errorMessage } from "@/lib/api-error";
+import { cn, timeAgo } from "@/lib/utils";
+
+const REFRESH_MS = 3_000;
+
+/**
+ * Read-only transcript of the live chat session, rendered as message bubbles.
+ *
+ * The live Chat tab is a PTY/Ink surface — a terminal cannot give a Persian
+ * paragraph its own direction, or a Persian paragraph and an English heading
+ * different alignments. This view reads the same session from `state.db` and
+ * renders it as blocks, so RTL content reads correctly while the rest of the
+ * dashboard stays LTR. It refreshes while open; sending still happens in the
+ * terminal (the "Reply in terminal" action returns there).
+ */
+export function SessionTranscript({
+  sessionId,
+  profile,
+  onReplyInTerminal,
+}: {
+  sessionId: string | null;
+  profile?: string;
+  onReplyInTerminal: () => void;
+}) {
+  const { t } = useI18n();
+  const [messages, setMessages] = useState<SessionMessage[] | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [pinnedToBottom, setPinnedToBottom] = useState(true);
+  const scrollerRef = useRef<HTMLDivElement>(null);
+  const requestRef = useRef(0);
+
+  const load = useCallback(() => {
+    if (!sessionId) {
+      setMessages([]);
+      setError(null);
+      return;
+    }
+    const request = ++requestRef.current;
+    api
+      .getSessionMessages(sessionId, profile)
+      .then((response) => {
+        if (requestRef.current !== request) return;
+        setMessages(response.messages);
+        setError(null);
+      })
+      .catch((e) => {
+        if (requestRef.current === request) setError(errorMessage(e));
+      });
+  }, [profile, sessionId]);
+
+  useEffect(() => {
+    load();
+    const interval = window.setInterval(() => {
+      if (document.visibilityState === "visible") load();
+    }, REFRESH_MS);
+    return () => window.clearInterval(interval);
+  }, [load]);
+
+  // Follow the tail unless the reader scrolled up to look at history.
+  useEffect(() => {
+    if (!pinnedToBottom) return;
+    const el = scrollerRef.current;
+    if (el) el.scrollTop = el.scrollHeight;
+  }, [messages, pinnedToBottom]);
+
+  const onScroll = useCallback(() => {
+    const el = scrollerRef.current;
+    if (!el) return;
+    setPinnedToBottom(el.scrollHeight - el.scrollTop - el.clientHeight < 96);
+  }, []);
+
+  const jumpToLatest = useCallback(() => {
+    const el = scrollerRef.current;
+    if (el) el.scrollTop = el.scrollHeight;
+    setPinnedToBottom(true);
+  }, []);
+
+  const visible = useMemo(
+    () => (messages ?? []).filter((message) => message.role !== "system").slice(-120),
+    [messages],
+  );
+
+  return (
+    <div className="absolute inset-0 z-10 flex min-h-0 flex-col bg-background-base">
+      <div className="flex shrink-0 items-center justify-between gap-2 border-b border-current/15 px-3 py-1.5">
+        <span className="flex items-center gap-1.5 text-xs tracking-wide text-text-secondary">
+          <MessageSquare className="h-3.5 w-3.5" aria-hidden />
+          {t.app?.messagesView ?? "Messages"}
+          <span className="text-text-tertiary tabular-nums">
+            {visible.length}
+          </span>
+        </span>
+        <button
+          type="button"
+          onClick={onReplyInTerminal}
+          className={cn(
+            "flex items-center gap-1.5 border border-current/25 px-2 py-1 text-xs",
+            "text-text-secondary transition-colors hover:border-primary/50 hover:text-foreground",
+          )}
+        >
+          <TerminalIcon className="h-3.5 w-3.5" aria-hidden />
+          {t.app?.replyInTerminal ?? "Reply in terminal"}
+        </button>
+      </div>
+
+      <div
+        ref={scrollerRef}
+        onScroll={onScroll}
+        className="relative min-h-0 flex-1 overflow-y-auto px-3 py-3 sm:px-5"
+      >
+        {error && (
+          <div className="mb-3 border border-destructive/40 bg-destructive/10 px-3 py-2 text-xs text-destructive">
+            {error}
+          </div>
+        )}
+        {!sessionId && (
+          <div className="flex h-full items-center justify-center px-6 text-center text-sm text-text-secondary">
+            {t.app?.transcriptEmpty ??
+              "Start a conversation in the terminal; its transcript appears here."}
+          </div>
+        )}
+        {sessionId && messages !== null && visible.length === 0 && !error && (
+          <div className="flex h-full items-center justify-center px-6 text-center text-sm text-text-secondary">
+            {t.sessions.noMessages}
+          </div>
+        )}
+
+        <div className="mx-auto flex w-full max-w-4xl flex-col gap-3">
+          {visible.map((message, index) => (
+            <TranscriptMessage key={`${message.role}-${message.timestamp ?? index}-${index}`} message={message} />
+          ))}
+        </div>
+
+        {!pinnedToBottom && (
+          <button
+            type="button"
+            onClick={jumpToLatest}
+            aria-label={t.app?.jumpToLatest ?? "Jump to latest"}
+            className={cn(
+              "sticky bottom-2 ms-auto flex items-center gap-1 border border-current/25",
+              "bg-background-base/95 px-2 py-1 text-xs text-text-secondary shadow",
+              "hover:border-primary/50 hover:text-foreground",
+            )}
+          >
+            <ArrowDown className="h-3.5 w-3.5" aria-hidden />
+            {t.app?.jumpToLatest ?? "Latest"}
+          </button>
+        )}
+      </div>
+    </div>
+  );
+}
+
+function TranscriptMessage({ message }: { message: SessionMessage }) {
+  const { t, locale } = useI18n();
+  const isUser = message.role === "user";
+  const isTool = message.role === "tool";
+  const hasToolCalls = Boolean(message.tool_calls?.length);
+
+  if (isTool) {
+    return (
+      <details className="group min-w-0 border border-border bg-secondary/30">
+        <summary className="flex cursor-pointer list-none items-center gap-2 px-3 py-2 text-xs text-text-secondary">
+          <Wrench className="h-3.5 w-3.5 shrink-0" aria-hidden />
+          <span className="min-w-0 flex-1 truncate">
+            {message.tool_name ?? t.sessions.roles.tool}
+          </span>
+          {message.timestamp && (
+            <span className="shrink-0 text-text-tertiary">
+              {timeAgo(message.timestamp, locale)}
+            </span>
+          )}
+        </summary>
+        {message.content && (
+          <div className="border-t border-border px-3 py-2">
+            <Markdown content={message.content} />
+          </div>
+        )}
+      </details>
+    );
+  }
+
+  return (
+    <div
+      className={cn(
+        "flex min-w-0 flex-col gap-1",
+        isUser ? "items-end" : "items-stretch",
+      )}
+    >
+      <div className="flex items-center gap-2 px-1 text-[0.6875rem] text-text-tertiary">
+        <span className="font-semibold text-text-secondary">
+          {isUser ? t.sessions.roles.user : t.sessions.roles.assistant}
+        </span>
+        {message.timestamp && <span>{timeAgo(message.timestamp, locale)}</span>}
+        {hasToolCalls && (
+          <span className="flex items-center gap-1">
+            <Wrench className="h-3 w-3" aria-hidden />
+            {message.tool_calls!.length}
+          </span>
+        )}
+      </div>
+      <div
+        className={cn(
+          "hermes-message-bubble min-w-0 max-w-[min(100%,52rem)] border border-border px-3 py-2",
+          isUser
+            ? "rounded-s-lg rounded-ee-lg bg-primary/[0.08]"
+            : "rounded-e-lg rounded-es-lg bg-secondary/40",
+        )}
+      >
+        {message.content ? <Markdown content={message.content} /> : null}
+        {hasToolCalls && (
+          <div className="mt-2 flex flex-wrap gap-1">
+            {message.tool_calls!.map((call) => (
+              <span
+                key={call.id}
+                className="border border-border px-1.5 py-0.5 font-mono text-[0.6875rem] text-text-secondary"
+              >
+                {call.function.name}
+              </span>
+            ))}
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
