new file mode 100644
index 0000000000..1beb4874f2
--- /dev/null
+++ b/web/src/components/ChatTabs.tsx
@@ -0,0 +1,104 @@
+import { Plus, X } from "lucide-react";
+
+import { cn } from "@/lib/utils";
+import type { ChatTab } from "@/lib/chat-tabs";
+import { NEW_TAB_ID } from "@/lib/chat-tabs";
+
+/**
+ * The open-conversation strip above the chat surface. Mirrors the desktop
+ * app's session tabs: the active conversation is highlighted, each tab closes
+ * with × or a middle click, and "+" starts a fresh chat.
+ *
+ * Switching tabs changes `?resume=`, which is how ChatPage already identifies
+ * a PTY, so no second terminal is kept alive — the tab is a navigation
+ * surface, not a second runtime.
+ */
+export function ChatTabs({
+  tabs,
+  activeId,
+  onSelect,
+  onClose,
+  onNew,
+  newLabel,
+  closeLabel,
+  label,
+}: {
+  tabs: ChatTab[];
+  activeId: string | null;
+  onSelect: (tab: ChatTab) => void;
+  onClose: (tab: ChatTab) => void;
+  onNew: () => void;
+  newLabel: string;
+  closeLabel: string;
+  label: string;
+}) {
+  return (
+    <div
+      className={cn(
+        "flex min-h-9 w-full min-w-0 items-stretch gap-1 overflow-x-auto overflow-y-hidden",
+        "border-b border-current/15 pb-1",
+      )}
+      role="tablist"
+      aria-label={label}
+    >
+      {tabs.map((tab) => {
+        const active = tab.id === activeId;
+        const isDraft = tab.id === NEW_TAB_ID;
+        return (
+          <div
+            key={tab.id}
+            className={cn(
+              "group flex max-w-56 min-w-0 shrink-0 items-center gap-1.5 border",
+              "px-2.5 py-1 text-xs transition-colors",
+              active
+                ? "border-primary/60 bg-primary/10 text-foreground"
+                : "border-transparent text-text-secondary hover:border-current/20 hover:bg-midground/5 hover:text-foreground",
+            )}
+          >
+            <button
+              type="button"
+              role="tab"
+              aria-selected={active}
+              onClick={() => onSelect(tab)}
+              onAuxClick={(event) => {
+                if (event.button === 1 && !isDraft) {
+                  event.preventDefault();
+                  onClose(tab);
+                }
+              }}
+              className="min-w-0 flex-1 truncate text-start normal-case tracking-normal"
+              title={tab.title}
+            >
+              {tab.title}
+            </button>
+            <button
+              type="button"
+              onClick={() => onClose(tab)}
+              aria-label={`${closeLabel}: ${tab.title}`}
+              title={closeLabel}
+              className={cn(
+                "shrink-0 rounded p-0.5 text-text-tertiary opacity-60 transition-opacity",
+                "hover:bg-midground/10 hover:text-foreground group-hover:opacity-100",
+              )}
+            >
+              <X className="h-3 w-3" />
+            </button>
+          </div>
+        );
+      })}
+
+      <button
+        type="button"
+        onClick={onNew}
+        aria-label={newLabel}
+        title={newLabel}
+        className={cn(
+          "flex shrink-0 items-center justify-center px-2 text-text-secondary",
+          "transition-colors hover:bg-midground/5 hover:text-foreground",
+        )}
+      >
+        <Plus className="h-4 w-4" />
+      </button>
+    </div>
+  );
+}
