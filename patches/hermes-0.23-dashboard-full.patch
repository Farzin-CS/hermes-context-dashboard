+import { describe, expect, it } from "vitest";
+
+import type { SessionInfo } from "./api";
+import { groupSessions, matchesSessionQuery } from "./session-groups";
+
+function session(overrides: Partial<SessionInfo> & { id: string }): SessionInfo {
+  const now = Date.now() / 1000;
+  const base: Omit<SessionInfo, "id"> = {
+    source: "cli",
+    model: "deepseek-flash",
+    title: "Session",
+    started_at: now - 60,
+    ended_at: null,
+    last_active: now - 60,
+    is_active: false,
+    message_count: 2,
+    tool_call_count: 0,
+    input_tokens: 0,
+    output_tokens: 0,
+    preview: null,
+  };
+  return { ...base, ...overrides };
+}
+
+describe("groupSessions", () => {
+  const now = Date.now() / 1000;
+  const day = 86_400;
+
+  it("puts pinned rows first and buckets the rest by calendar day", () => {
+    const groups = groupSessions([
+      session({ id: "pinned", pinned: true, last_active: now - 30 * day }),
+      session({ id: "today", last_active: now - 60 }),
+      session({ id: "yesterday", last_active: now - day - 60 }),
+      session({ id: "week", last_active: now - 3 * day }),
+      session({ id: "earlier", last_active: now - 20 * day }),
+    ]);
+
+    expect(groups.map((group) => group.key)).toEqual([
+      "pinned",
+      "today",
+      "yesterday",
+      "week",
+      "earlier",
+    ]);
+    expect(groups.flatMap((group) => group.sessions.map((row) => row.id))).toEqual([
+      "pinned",
+      "today",
+      "yesterday",
+      "week",
+      "earlier",
+    ]);
+  });
+
+  it("omits empty buckets", () => {
+    const groups = groupSessions([session({ id: "only", last_active: now - 60 })]);
+    expect(groups).toHaveLength(1);
+    expect(groups[0].key).toBe("today");
+  });
+});
+
+describe("matchesSessionQuery", () => {
+  it("matches title, model and id, case-insensitively", () => {
+    const row = session({ id: "abc123", title: "گزارشکار آزمایش" });
+    expect(matchesSessionQuery(row, "گزارشکار")).toBe(true);
+    expect(matchesSessionQuery(row, "DEEPSEEK")).toBe(true);
+    expect(matchesSessionQuery(row, "abc123")).toBe(true);
+    expect(matchesSessionQuery(row, "missing")).toBe(false);
+    expect(matchesSessionQuery(row, "   ")).toBe(true);
+  });
+});
diff --git a/web/src/lib/session-groups.ts b/web/src/lib/session-groups.ts
new file mode 100644
index 0000000000..615239f3ed
--- /dev/null
+++ b/web/src/lib/session-groups.ts
@@ -0,0 +1,72 @@
+import type { SessionInfo } from "@/lib/api";
+
+export type SessionGroupKey = "pinned" | "today" | "yesterday" | "week" | "earlier";
+
+export interface SessionGroup {
+  key: SessionGroupKey;
+  sessions: SessionInfo[];
+}
+
+function startOfDay(ts: number): number {
+  const d = new Date(ts * 1000);
+  d.setHours(0, 0, 0, 0);
+  return d.getTime();
+}
+
+function seconds(value: number | null | undefined): number {
+  if (!value || !Number.isFinite(value)) return 0;
+  // Session rows are epoch seconds. Ignore millisecond values by scaling.
+  return value > 1e12 ? Math.round(value / 1000) : value;
+}
+
+/**
+ * Group sessions the way the desktop sidebar does: pinned rows first, then
+ * calendar buckets (Today, Yesterday, Previous 7 days, Earlier). Sessions are
+ * kept in the order the API returned them inside each bucket, so "recent"
+ * ordering is preserved. Empty groups are omitted.
+ */
+export function groupSessions(sessions: SessionInfo[]): SessionGroup[] {
+  const now = new Date();
+  const today = startOfDay(now.getTime() / 1000);
+  const yesterday = today - 86_400_000;
+  const week = today - 7 * 86_400_000;
+
+  const groups: SessionGroup[] = [
+    { key: "pinned", sessions: [] },
+    { key: "today", sessions: [] },
+    { key: "yesterday", sessions: [] },
+    { key: "week", sessions: [] },
+    { key: "earlier", sessions: [] },
+  ];
+  const byKey = new Map(groups.map((g) => [g.key, g]));
+
+  for (const session of sessions) {
+    if (session.pinned) {
+      byKey.get("pinned")!.sessions.push(session);
+      continue;
+    }
+    const day = startOfDay(seconds(session.last_active) || seconds(session.started_at));
+    if (day >= today) byKey.get("today")!.sessions.push(session);
+    else if (day >= yesterday) byKey.get("yesterday")!.sessions.push(session);
+    else if (day >= week) byKey.get("week")!.sessions.push(session);
+    else byKey.get("earlier")!.sessions.push(session);
+  }
+
+  return groups.filter((group) => group.sessions.length > 0);
+}
+
+export function matchesSessionQuery(session: SessionInfo, query: string): boolean {
+  const needle = query.trim().toLowerCase();
+  if (!needle) return true;
+  const haystack = [
+    session.title,
+    session.preview,
+    session.model,
+    session.source,
+    session.id,
+  ]
+    .filter(Boolean)
+    .join(" ")
+    .toLowerCase();
+  return needle.split(/\s+/).every((part) => haystack.includes(part));
+}
