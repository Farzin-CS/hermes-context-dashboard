+/**
+ * Text direction helpers for mixed English / Persian / Arabic content.
+ *
+ * The dashboard flips its whole shell when the locale is RTL, but agent
+ * output is mixed: one assistant reply can hold an English summary, a
+ * Persian paragraph, a shell command and a JSON blob. Direction is resolved
+ * per block instead of per page so a Persian paragraph reads right-to-left
+ * while the surrounding dashboard (and every code block) stays LTR.
+ *
+ * `unicode-bidi: plaintext` does the heavy lifting in CSS (`index.css`,
+ * `.hermes-md-block`): each rendered line picks its direction from its own
+ * first strong character. These helpers cover the cases CSS cannot:
+ * elements whose chrome (list markers, quote borders) needs a box-level
+ * direction, and callers that want to know whether a string is RTL at all.
+ */
+
+/** Strong RTL code points: Hebrew, Arabic, Syriac, Thaana, NKo, Samaritan,
+ *  Arabic Extended, presentation forms. Digits/punctuation are neutral. */
+const RTL_CHAR =
+  /[\u0590-\u05FF\u0600-\u06FF\u0700-\u074F\u0750-\u077F\u0780-\u07BF\u07C0-\u07FF\u0800-\u083F\u0840-\u085F\u0860-\u086F\u0870-\u089F\u08A0-\u08FF\uFB1D-\uFDFF\uFE70-\uFEFF]/;
+
+/** True when `text` contains at least one strong right-to-left character. */
+export function hasRtlText(text: string | null | undefined): boolean {
+  return typeof text === "string" && RTL_CHAR.test(text);
+}
+
+/**
+ * Direction for a block box: `"rtl"` when the first strong character is
+ * RTL, `"ltr"` when it is LTR, `undefined` when the text is neutral (pure
+ * digits, punctuation, emoji) — then the surrounding block decides.
+ */
+export function blockDirection(
+  text: string | null | undefined,
+): "rtl" | "ltr" | undefined {
+  if (typeof text !== "string") return undefined;
+  for (const char of text) {
+    if (RTL_CHAR.test(char)) return "rtl";
+    if (/[A-Za-z\u00C0-\u024F\u0370-\u03FF\u0400-\u04FF]/.test(char)) {
+      return "ltr";
+    }
+  }
+  return undefined;
+}
+
+/**
+ * `dir` attribute value for a text block. `"auto"` lets the browser resolve
+ * direction per element from its content (the HTML standard, same rule as
+ * `blockDirection`), which is what we want for markdown paragraphs.
+ */
+export function autoDir(text: string | null | undefined): "auto" | "ltr" {
+  return hasRtlText(text) ? "auto" : "ltr";
+}
