index 0000000000..63a89e9ffe
--- /dev/null
+++ b/web/src/lib/chat-tabs.test.ts
@@ -0,0 +1,48 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  NEW_TAB_ID,
+  removeChatTab,
+  sessionTitleOrFallback,
+  upsertChatTab,
+  type ChatTab,
+} from "./chat-tabs";
+
+const tab = (id: string, title = id): ChatTab => ({ id, title });
+
+describe("chat tabs", () => {
+  it("appends new tabs and updates existing ones in place", () => {
+    const first = upsertChatTab([], tab("a"));
+    const second = upsertChatTab(first, tab("b"));
+    expect(second.map((item) => item.id)).toEqual(["a", "b"]);
+
+    const renamed = upsertChatTab(second, tab("a", "new title"));
+    expect(renamed).toHaveLength(2);
+    expect(renamed[0]).toEqual({ id: "a", title: "new title" });
+  });
+
+  it("caps the strip at twelve tabs, dropping the oldest", () => {
+    let tabs: ChatTab[] = [];
+    for (let index = 0; index < 15; index += 1) {
+      tabs = upsertChatTab(tabs, tab(`s${index}`));
+    }
+    expect(tabs).toHaveLength(12);
+    expect(tabs[0].id).toBe("s3");
+    expect(tabs.at(-1)?.id).toBe("s14");
+  });
+
+  it("removes one tab without touching the rest", () => {
+    const tabs = [tab("a"), tab(NEW_TAB_ID, "New chat"), tab("b")];
+    expect(removeChatTab(tabs, NEW_TAB_ID).map((item) => item.id)).toEqual(["a", "b"]);
+  });
+
+  it("falls back from a placeholder title to the preview, then the label", () => {
+    expect(sessionTitleOrFallback({ title: "Untitled", preview: "hello" }, "New")).toBe(
+      "hello",
+    );
+    expect(sessionTitleOrFallback({ title: null, preview: null }, "New")).toBe("New");
+    expect(sessionTitleOrFallback({ title: "Real", preview: "ignored" }, "New")).toBe(
+      "Real",
+    );
+  });
+});
diff --git a/web/src/lib/chat-tabs.ts b/web/src/lib/chat-tabs.ts
new file mode 100644
index 0000000000..795ddcf53a
--- /dev/null
+++ b/web/src/lib/chat-tabs.ts
@@ -0,0 +1,61 @@
+/** Persisted "open session" tabs for the chat tab strip. */
+export interface ChatTab {
+  /** Session id, or `NEW_TAB_ID` for an unsaved draft. */
+  id: string;
+  title: string;
+}
+
+export const NEW_TAB_ID = "__new__";
+const STORAGE_KEY = "hermes-chat-tabs";
+const MAX_TABS = 12;
+
+export function readChatTabs(): ChatTab[] {
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY);
+    if (!raw) return [];
+    const parsed: unknown = JSON.parse(raw);
+    if (!Array.isArray(parsed)) return [];
+    return parsed
+      .filter(
+        (tab): tab is ChatTab =>
+          Boolean(tab) &&
+          typeof (tab as ChatTab).id === "string" &&
+          typeof (tab as ChatTab).title === "string",
+      )
+      .slice(0, MAX_TABS);
+  } catch {
+    return [];
+  }
+}
+
+export function writeChatTabs(tabs: ChatTab[]): void {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(tabs.slice(0, MAX_TABS)));
+  } catch {
+    // ignore quota / privacy mode
+  }
+}
+
+/** Add or update a tab, keeping insertion order and the cap. */
+export function upsertChatTab(tabs: ChatTab[], tab: ChatTab): ChatTab[] {
+  const index = tabs.findIndex((t) => t.id === tab.id);
+  if (index === -1) return [...tabs, tab].slice(-MAX_TABS);
+  const next = tabs.slice();
+  next[index] = tab;
+  return next;
+}
+
+export function removeChatTab(tabs: ChatTab[], id: string): ChatTab[] {
+  return tabs.filter((tab) => tab.id !== id);
+}
+
+export function sessionTitleOrFallback(
+  session: { title?: string | null; preview?: string | null },
+  fallback: string,
+): string {
+  const title = session.title?.trim();
+  if (title && title !== "Untitled") return title;
+  const preview = session.preview?.trim();
+  if (preview) return preview.slice(0, 42);
+  return fallback;
+}
