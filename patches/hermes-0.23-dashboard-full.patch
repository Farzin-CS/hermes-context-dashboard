diff --git a/web/src/components/ChatAttachmentBar.tsx b/web/src/components/ChatAttachmentBar.tsx
new file mode 100644
index 0000000000..bedad88ddf
--- /dev/null
+++ b/web/src/components/ChatAttachmentBar.tsx
@@ -0,0 +1,287 @@
+import { Button } from "@nous-research/ui/ui/components/button";
+import {
+  AlertCircle,
+  FileText,
+  Image as ImageIcon,
+  Loader2,
+  Paperclip,
+  X,
+} from "lucide-react";
+import { useEffect, useRef, useState, type ChangeEvent } from "react";
+
+import { useI18n } from "@/i18n";
+import { uploadChatFile } from "@/lib/chat-file-upload";
+import { uploadChatImage } from "@/lib/chatImagePaste";
+import {
+  type ChatAttachment,
+  type ChatAttachmentKind,
+} from "@/lib/chat-attachments";
+import { cn } from "@/lib/utils";
+
+interface BarCopy {
+  attach: string;
+  uploading: string;
+  uploadFailed: string;
+  remove: string;
+  hint: string;
+  notConnected: string;
+  tooLarge: string;
+  attached: string;
+}
+
+type PendingStatus = "uploading" | "ready" | "error";
+
+const FALLBACK_COPY: BarCopy = {
+  attach: "Attach files",
+  uploading: "Uploading…",
+  uploadFailed: "Upload failed",
+  remove: "Remove",
+  hint: "Attach files, then type your prompt in the terminal and press Enter.",
+  notConnected: "Chat is not connected.",
+  tooLarge: "File is too large (max {mb} MB).",
+  attached: "attached",
+};
+
+interface PendingAttachment extends ChatAttachment {
+  file: File;
+  status: PendingStatus;
+  error?: string;
+}
+
+export interface ChatAttachmentBarProps {
+  profile?: string;
+  connected: boolean;
+  resetKey?: number;
+  onFilesChange: (files: ChatAttachment[]) => void;
+  onImagesReady: (
+    images: { path: string; name: string }[],
+  ) => Promise<void> | void;
+}
+
+const MAX_FILE_BYTES = 16 * 1024 * 1024;
+const MAX_IMAGE_BYTES = 25 * 1024 * 1024;
+
+function newId(): string {
+  if (typeof crypto !== "undefined" && "randomUUID" in crypto) {
+    return crypto.randomUUID();
+  }
+  return `${Date.now()}-${Math.random().toString(16).slice(2)}`;
+}
+
+function isImageFile(file: File): boolean {
+  const type = file.type.toLowerCase();
+  // Keep this list in sync with chatImagePaste's IMAGE_MIME_EXT. Types the
+  // /image endpoint does not accept (SVG, AVIF, HEIC, TIFF) fall back to a
+  // generic file attachment instead of failing the upload.
+  return (
+    type === "image/png" ||
+    type === "image/jpeg" ||
+    type === "image/jpg" ||
+    type === "image/gif" ||
+    type === "image/webp" ||
+    type === "image/bmp" ||
+    (!type && /\.(bmp|gif|jpe?g|png|webp)$/i.test(file.name))
+  );
+}
+
+function formatBytes(bytes: number): string {
+  if (!Number.isFinite(bytes) || bytes <= 0) return "0 B";
+  if (bytes < 1024) return `${bytes} B`;
+  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
+  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
+}
+
+function errorText(err: unknown): string {
+  return err instanceof Error ? err.message : String(err);
+}
+
+export function ChatAttachmentBar({
+  profile = "",
+  connected,
+  resetKey = 0,
+  onFilesChange,
+  onImagesReady,
+}: ChatAttachmentBarProps) {
+  const { t } = useI18n();
+  const copy: BarCopy = t.app.chatComposer ?? FALLBACK_COPY;
+  const [items, setItems] = useState<PendingAttachment[]>([]);
+  const [error, setError] = useState<string | null>(null);
+  const inputRef = useRef<HTMLInputElement | null>(null);
+  const aliveRef = useRef(true);
+
+  useEffect(() => {
+    aliveRef.current = true;
+    return () => {
+      aliveRef.current = false;
+    };
+  }, []);
+
+  // The Enter handler in ChatPage consumes the ready files and bumps this
+  // key; drop their chips once the prompt has been submitted.
+  useEffect(() => {
+    setItems([]);
+    setError(null);
+  }, [resetKey]);
+
+  const updateItem = (id: string, patch: Partial<PendingAttachment>) => {
+    setItems((current) =>
+      current.map((item) => (item.id === id ? { ...item, ...patch } : item)),
+    );
+  };
+
+  // Keep ChatPage's Enter handler in sync with the ready file attachments.
+  useEffect(() => {
+    onFilesChange(
+      items
+        .filter((item) => item.kind === "file" && item.status === "ready")
+        .map(({ id, name, path, kind, size }) => ({
+          id,
+          name,
+          path,
+          kind,
+          size,
+        })),
+    );
+  }, [items, onFilesChange]);
+
+  const addFiles = async (picked: File[]) => {
+    if (!picked.length) return;
+    setError(null);
+    const queued: PendingAttachment[] = picked.map((file) => ({
+      id: newId(),
+      file,
+      name: file.name || "attachment",
+      path: "",
+      kind: (isImageFile(file) ? "image" : "file") as ChatAttachmentKind,
+      size: file.size,
+      status: "uploading",
+    }));
+    setItems((current) => [...current, ...queued]);
+
+    for (const item of queued) {
+      try {
+        if (!item.file.size) throw new Error("file is empty");
+        if (item.kind === "image") {
+          if (item.size > MAX_IMAGE_BYTES) {
+            throw new Error(copy.tooLarge.replace("{mb}", "25"));
+          }
+          const uploaded = await uploadChatImage(item.file, profile);
+          if (!aliveRef.current) return;
+          updateItem(item.id, { path: uploaded.path, status: "ready" });
+          await onImagesReady([{ path: uploaded.path, name: item.name }]);
+        } else {
+          if (item.size > MAX_FILE_BYTES) {
+            throw new Error(copy.tooLarge.replace("{mb}", "16"));
+          }
+          const uploaded = await uploadChatFile(item.file, profile);
+          if (!aliveRef.current) return;
+          updateItem(item.id, { path: uploaded.path, status: "ready" });
+        }
+      } catch (err) {
+        if (!aliveRef.current) return;
+        const message = errorText(err);
+        updateItem(item.id, { status: "error", error: message });
+        setError(`${copy.uploadFailed}: ${message}`);
+      }
+    }
+  };
+
+  const handlePicked = (event: ChangeEvent<HTMLInputElement>) => {
+    const files = Array.from(event.target.files ?? []);
+    // Allow picking the same file again after removing it.
+    event.target.value = "";
+    void addFiles(files);
+  };
+
+  const remove = (id: string) => {
+    setItems((current) => current.filter((item) => item.id !== id));
+    setError(null);
+  };
+
+  return (
+    <div className="flex shrink-0 flex-col gap-2 rounded-lg border border-current/15 bg-background-base/60 p-2">
+      {items.length > 0 && (
+        <div className="flex flex-wrap gap-1.5">
+          {items.map((item) => {
+            const Icon = item.kind === "image" ? ImageIcon : FileText;
+            const removable = item.kind === "file" || item.status === "error";
+            return (
+              <span
+                key={item.id}
+                title={item.error || item.name}
+                className={cn(
+                  "inline-flex max-w-full items-center gap-1.5 rounded border px-2 py-1 text-xs",
+                  item.status === "error"
+                    ? "border-destructive/50 text-destructive"
+                    : "border-current/20 text-current/80",
+                )}
+              >
+                <Icon className="h-3.5 w-3.5 shrink-0" />
+                <span className="max-w-[14rem] truncate">{item.name}</span>
+                <span className="shrink-0 text-current/50">
+                  {formatBytes(item.size)}
+                </span>
+                {item.status === "uploading" && (
+                  <Loader2
+                    className="h-3.5 w-3.5 shrink-0 animate-spin"
+                    aria-label={copy.uploading}
+                  />
+                )}
+                {item.status === "error" && (
+                  <AlertCircle className="h-3.5 w-3.5 shrink-0" />
+                )}
+                {item.status === "ready" && item.kind === "image" && (
+                  <span className="shrink-0 text-current/50">
+                    {copy.attached}
+                  </span>
+                )}
+                {removable && (
+                  <button
+                    type="button"
+                    onClick={() => remove(item.id)}
+                    aria-label={`${copy.remove} ${item.name}`}
+                    title={copy.remove}
+                    className="shrink-0 rounded p-0.5 hover:bg-current/10"
+                  >
+                    <X className="h-3.5 w-3.5" />
+                  </button>
+                )}
+              </span>
+            );
+          })}
+        </div>
+      )}
+
+      <div className="flex flex-wrap items-center gap-2">
+        <input
+          ref={inputRef}
+          type="file"
+          multiple
+          className="hidden"
+          onChange={handlePicked}
+          data-testid="chat-attachment-input"
+        />
+        <Button
+          ghost
+          size="sm"
+          onClick={() => inputRef.current?.click()}
+          aria-label={copy.attach}
+          title={copy.attach}
+          className="gap-1.5"
+        >
+          <Paperclip className="h-4 w-4" />
+          <span>{copy.attach}</span>
+        </Button>
+        <span className="text-xs text-muted-foreground">
+          {connected ? copy.hint : copy.notConnected}
+        </span>
+      </div>
+
+      {error && (
+        <div role="alert" className="text-xs text-destructive">
+          {error}
+        </div>
+      )}
+    </div>
+  );
+}
